{
  "name": "sp-progress-dashboard",
  "version": "0.1.0",
  "description": "A calm, executive-function-friendly (ADHD/autism) instrument for Super Productivity — makes steady progress across your projects legible at a glance and rewards the hours you put in, day after day.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:min": "./scripts/minify.sh sp-dashboard",
    "check:syntax": "node scripts/check-js.js",
    "screenshot": "node scripts/screenshot.js",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "html-minifier-terser": "^6.1.0",
    "jsdom": "^23.0.0",
    "puppeteer": "^24.37.5",
    "vitest": "^1.0.4"
  },
  "keywords": [
    "super-productivity",
    "plugin",
    "dashboard"
  ],
  "author": "Raian256",
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.16.0"
  }
}
